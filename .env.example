# Every setting. You don't need this file: `node watch.mjs` asks the questions and writes .env for you.
# To set things up by hand instead, copy this file to .env and fill in the lines you want.

# --- Where you are ---------------------------------------------------------------------------------
# Your US ZIP code. (Or set LAT and LNG instead, e.g. LAT=40.75 and LNG=-73.99.)
ZIP=
# Alert about Apple Stores within this many miles.
RADIUS_MI=25
# Smallest storage you'd buy: 256gb, 512gb, 1tb or 2tb.
MIN_CAP=256gb
# Set to 0 to skip the "already in stock" message when the watcher starts.
NOTIFY_ON_START=1

# --- How to tell you: fill in one or more ---------------------------------------------------------
# Slack: an incoming webhook URL (https://hooks.slack.com/...).
SLACK_WEBHOOK_URL=

# Google Chat: a space's webhook link (https://chat.googleapis.com/...).
GOOGLE_CHAT_WEBHOOK_URL=

# Email. EMAIL_PASSWORD is a Gmail app password (https://myaccount.google.com/apppasswords).
# EMAIL_TO can list several addresses, separated by commas.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
# Not Gmail? Set your provider's SMTP server. Port 465 uses TLS; any other port uses STARTTLS.
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=465
# EMAIL_FROM=

# Text message, through Twilio (https://www.twilio.com). Phone numbers look like +12125551234.
# TEXT_TO can list several numbers, separated by commas.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TEXT_TO=

# Slack, advanced: post as a Slack bot instead of a webhook. SLACK_DM is a user ID to also DM
# every alert to; SLACK_MENTION is a user ID to @-mention on every alert.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL="#duo-alerts"
# SLACK_DM=
# SLACK_MENTION=
